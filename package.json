{
  "name": "sqlclient",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "bin": {
    "sqlclient": "src/index.tsx"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
