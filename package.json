    "format:check": "prettier --check .",
    "build": "bun build --compile src/index.tsx --outfile sqlclient"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "prettier": "^3.9.6",
    "typescript": "^7"
  },
  "dependencies": {
    "ink": "^7",
    "react": "^19",
    "sql-highlight": "^6.1.0"
  }
}
